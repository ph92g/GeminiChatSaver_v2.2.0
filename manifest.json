{
  "manifest_version": 3,
  "name": "Gemini Chat Saver Ultra",
  "version": "2.1.0",
  "description": "Export Gemini chat history by automatically scrolling to the oldest available message, waiting for lazy-loaded history to finish, then packaging the complete loaded chat as Markdown.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
